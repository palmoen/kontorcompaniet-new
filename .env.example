# Kanonisk domene (brukes i canonical, sitemap og strukturerte data)
NEXT_PUBLIC_SITE_URL=https://kontorcompaniet.no

# Eget Supabase-prosjekt for kontorcompaniet.no (ikke delt med MerchMaker/Workshop Studio/Donna)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kun server-side. Aldri eksponert til nettleseren.
SUPABASE_SERVICE_ROLE_KEY=

# Direkte Postgres: HELE tilkoblingsstrengen, ikke bare vertsnavnet. Supabase → Connect → Transaction pooler, f.eks.
# postgresql://postgres.rswtbsgnewhaxyimagvs:<passord>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# AI – OpenAI. Uten nøkkel brukes regelbasert tolkning, og tale er slått av.
OPENAI_API_KEY=
OPENAI_SCOUT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Beskytter /api/cron/* (brukes av pg_cron). Minst 16 tegn.
CRON_SECRET=

# E-post via Resend. Uten nøkkel logges varsler i stedet for å sendes.
RESEND_API_KEY=
EMAIL_FROM="Kontorcompaniet <post@kontorcompaniet.no>"
SALES_NOTIFY_EMAIL=

# "true" KUN i produksjon. Preview/staging får noindex og robots Disallow.
SITE_INDEXABLE=false
